{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://ep-curly-dust-bd5ao033.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth/:path*"
    },
    { "source": "/((?!api/|auth/).*)", "destination": "/" }
  ]
}
